# Phase 0 local dev (no Docker required). Staging/prod use docker-compose.yml.
PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-only-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SEC=300
OTP_MODE=mock
# OTP_MODE=termii when ready:
# TERMII_API_KEY=
# TERMII_SENDER=WasteApp
# TERMII_CHANNEL=sms
S3_ENDPOINT=
S3_BUCKET=waste-marketplace-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:4000/uploads
PILOT_LGAS=Eti-Osa,Ikeja
CANCELLATION_PENALTY_NGN=3000
