# Phase 0 local dev (no Docker required). Staging/prod use docker-compose.yml.
PORT=4000
DATABASE_URL=file:./dev.db
# Staging/prod (PostgreSQL via pg; tables follow apps/api/db/schema.sql):
# DATABASE_URL=postgres://waste:waste@localhost:5432/waste_marketplace
# Render external Postgres URLs need TLS (auto when host ends .render.com);
# force it anywhere with PGSSLMODE=require:
# PGSSLMODE=require
JWT_SECRET=dev-only-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SEC=300
OTP_MODE=mock
# OTP_MODE=termii when ready:
# TERMII_API_KEY=
# TERMII_SENDER=WasteApp
# TERMII_CHANNEL=sms
# Photo storage: leave S3_* empty for mock/dev mode (keys work end to end for
# testing, no bytes stored — not for production). For real storage (Cloudflare
# R2 / S3-compatible, region auto) set ALL five:
S3_ENDPOINT=
S3_BUCKET=waste-marketplace-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:4000/uploads
# Real example (R2):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=waste-marketplace
# S3_ACCESS_KEY=<r2-access-key>
# S3_SECRET_KEY=<r2-secret-key>
# S3_PUBLIC_BASE_URL=https://photos.example.com
PILOT_LGAS=Eti-Osa,Ikeja
CANCELLATION_PENALTY_NGN=3000
# NOTE: npm run seed never creates the default admin when NODE_ENV=production
# or DATABASE_URL is Postgres (it demotes that row instead; see cleanup:default-admin).
# Admin seeder (npm run seed:admin): all optional except ADMIN_PASSWORD.
# ADMIN_PHONE=+2348000000001
# ADMIN_NAME=Ops Admin
# ADMIN_PASSWORD=change-me-to-12-plus-chars
# Paystack: mock (default, local/tests) or live (real initialize + verified webhooks):
PAYSTACK_MODE=mock
# PAYSTACK_MODE=live when ready:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co
