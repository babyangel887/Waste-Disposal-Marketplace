{
  "expo": {
    "name": "Waste Vendor",
    "slug": "waste-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "waste-vendor",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.wastedisposal.vendor",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow waste pickup location for driver arrival."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0907680-d043-4ee3-91df-6a9a328f179c"
      }
    },"owner": "babyangel887"
  }
}
